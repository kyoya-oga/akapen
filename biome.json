{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useConst": "error",
        "noVar": "error",
        "noParameterAssign": "error",
        "useDefaultSwitchClause": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noNonNullAssertion": "error",
        "noNamespace": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noAssignInExpressions": "error",
        "noGlobalAssign": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noEvolvingTypes": "error"
      },
      "complexity": {
        "noForEach": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessSwitchCase": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      }
    }
  },
  "overrides": [
    {
      "include": ["src/core/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": [
                  "window",
                  "document",
                  "localStorage",
                  "sessionStorage",
                  "indexedDB",
                  "fetch",
                  "location",
                  "navigator"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "ignore": [
      "dist/**",
      "install.html",
      "node_modules/**",
      "src/viewer/embedded-bundle.ts",
      "test-results/**",
      "playwright-report/**"
    ]
  }
}
